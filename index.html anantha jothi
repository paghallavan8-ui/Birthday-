<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Anantha Jothi ❤️</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 99%, #fad0c4 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            text-align: center;
        }

        .container {
            background: rgba(255, 255, 255, 0.2);
            padding: 2rem;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            z-index: 10;
            max-width: 90%;
        }

        h1 {
            color: #d63384;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        p {
            color: #4a4a4a;
            font-size: 1.2rem;
            line-height: 1.6;
        }

        /* Floating Hearts Animation */
        .heart {
            position: absolute;
            color: rgba(214, 51, 132, 0.6);
            font-size: 1.5rem;
            user-select: none;
            animation: float 5s infinite linear;
            bottom: -50px;
        }

        @keyframes float {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }

        .btn {
            background: #d63384;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.3s ease;
            margin-top: 20px;
        }

        .btn:hover {
            transform: scale(1.1);
        }

        #special-message {
            display: none;
            margin-top: 20px;
            font-style: italic;
            color: #8b2055;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Happy Birthday, <br>Anantha Jothi! 🎂</h1>
        <p>To the most amazing person in my world. You make every day brighter just by being you.</p>
        
        <button class="btn" onclick="revealMessage()">Click for a surprise ❤️</button>
        <div id="special-message">
            "I am so lucky to have you. Here's to many more years of happiness together!"
        </div>
    </div>

    <script>
        // Function to reveal the secret message
        function revealMessage() {
            document.getElementById('special-message').style.display = 'block';
            for(let i=0; i<15; i++) {
                setTimeout(createHeart, i * 100);
            }
        }

        // Function to create floating hearts
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '❤️';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = (Math.random() * 3 + 2) + 's';
            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 5000);
        }

        // Create initial background hearts
        setInterval(createHeart, 800);
    </script>
</body>
</html>
